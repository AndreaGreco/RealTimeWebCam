<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>RTVirtualCamera</RootNamespace>
    <AssemblyName>RTVirtualCamera</AssemblyName>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <ApplicationIcon>Resources\Icon.ico</ApplicationIcon>

    <!-- Self-contained: bundles the .NET 10 runtime into the app's own output
         folder, so the MSI keeps working on a machine that never had .NET 10
         installed (was silently relying on the shared runtime being present).
         AppendRuntimeIdentifierToOutputPath=false is the important part: without
         it, the SDK would nest output under an extra "win-x64" folder and break
         every path that assumes ..\bin\x64\<Config>\ directly (RTCamNative.dll
         colocation, deploy_vcam.ps1, the WiX harvest in Setup\Package.wxs). With
         it off, a normal Debug/Release build already produces the full
         self-contained closure in the existing folder — no publish step, no
         other file needs to change. -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

    <!-- The SDK also appends a TargetFramework folder segment by default
         (bin\x64\Debug\net10.0-windows10.0.22000.0\), independently of the
         RuntimeIdentifier one above. Missing this is almost certainly why
         RTVirtualCamera.exe stopped finding RTCamNative.dll: the exe was
         landing one folder deeper than the native project's plain
         bin\x64\<Config>\ output, so P/Invoke's app-directory search missed it. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <!-- AssemblyVersion/AssemblyFileVersion/AssemblyInformationalVersion come from
         build/Version.g.cs (git-derived, see build/Set-GitVersion.ps1). The rest of
         the assembly attributes (title, product, GUID, ComVisible...) come from
         Properties/AssemblyInfo.cs. Keep the SDK from generating its own copies of
         either, or the build fails with duplicate-attribute errors. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

    <!-- bin/obj layout unchanged from the old-style project, so RTCamNative.dll
         (built by the sibling native project into the same folder) is still found
         next to the exe at runtime without any assembly reference. -->
    <BaseOutputPath>..\bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <OutputPath>..\bin\x64\Debug\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <OutputPath>..\bin\x64\Release\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Dead scaffolding: the app persists settings itself via Settings.cs (JSON to
         %LOCALAPPDATA%), Properties.Settings/ApplicationSettingsBase is never
         referenced anywhere. Excluded rather than deleted for now. -->
    <Compile Remove="Properties\Settings.Designer.cs" />
    <None Remove="Properties\Settings.settings" />
  </ItemGroup>

  <ItemGroup>
    <!-- Git-derived version attributes, regenerated pre-build by ..\build\GitVersion.targets. -->
    <Compile Include="..\build\Version.g.cs" Link="Properties\Version.g.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\Icon.ico" />
    <Content Include="Resources\Icon.svg" />
  </ItemGroup>

  <ItemGroup>
    <!-- Strongly-typed resources codegen (the only .resx that needs it; satellite
         .xx-XX.resx files are picked up automatically by the SDK's implicit globbing). -->
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <Import Project="..\build\GitVersion.targets" />

</Project>
