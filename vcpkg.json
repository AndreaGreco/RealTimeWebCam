{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg/master/scripts/vcpkg.schema.json",
  "name": "rtvirtualcamera",
  "version-string": "0.1.0",
  "description": "RTSP virtual camera. FFmpeg (LGPL, decode-only) is used by the optional user-space receive engine in RTCamNative.",
  "builtin-baseline": "af629d8717ee75a8c2418135064ffd59a7019f1c",
  "dependencies": [
    {
      "name": "ffmpeg",
      "default-features": false,
      "features": [
        "avcodec",
        "avformat",
        "swscale"
      ]
    }
  ]
}
