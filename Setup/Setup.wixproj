<Project Sdk="WixToolset.Sdk/7.0.0">
  <PropertyGroup>
    <!-- MSI filename: RT-VirtualCam-Setup.msi (default would be the project name, Setup). -->
    <OutputName>RT-VirtualCam-Setup</OutputName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="7.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MFPipeline\MFPipeline.vcxproj" />
    <ProjectReference Include="..\RTVirtualCamera\RTVirtualCamera.csproj" />
    <ProjectReference Include="..\VirtualCamera\VCamSampleSource.vcxproj" />
  </ItemGroup>
  <Import Project="..\build\GitVersion.targets" />
</Project>