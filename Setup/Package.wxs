<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
	 xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

	<!-- BuildVersion is generated from git into Version.g.wxi (build/Set-GitVersion.ps1). -->
	<?include Version.g.wxi ?>

	<Package Name="RTVirtualCamera"
			 Manufacturer="RTVirtualCamera"
			 Version="$(BuildVersion)"
			 InstallerVersion="500"
			 UpgradeCode="e562ae5c-6739-11f1-a64b-80fa5b84a72b"
			 Compressed="yes"
			 >

		<!-- Embed the cab inside the MSI so the installer is a single file -->
		<MediaTemplate EmbedCab="yes" />

		<!-- Clean upgrade behavior: without this, UpgradeCode alone does nothing and
		     installing a newer MSI over an older one just errors out instead of
		     replacing it. DowngradeError is declared in Package.en-us.wxl. -->
		<MajorUpgrade DowngradeErrorMessage="!(loc.DowngradeError)" />

		<!-- Icon shown in Settings > Apps / Programs and Features. Shortcuts below
		     don't need this: a Shortcut whose Target is the .exe directly picks up
		     the icon embedded in RTVirtualCamera.exe (see ApplicationIcon in the
		     csproj) automatically. -->
		<Icon Id="AppIcon.ico" SourceFile="..\RTVirtualCamera\Resources\Icon.ico" />
		<Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />

		<StandardDirectory Id="ProgramFiles64Folder">
			<Directory Id="INSTALLFOLDER" Name="RTVirtualCamera">
				<!-- COM DLL: esplicita perche' serve la registrazione <Class>.
				     Tutto il resto dell'app viene raccolto da <Files> qui sotto. -->
				<Component Id="CameraCOM">
					<File Id="VCamComDll" Source="$(var.VCamSampleSource.TargetPath)" />
					<Class Id="3CAD447D-F283-4AF4-A3B2-6F5363309F52"
						Context="InprocServer32"
						ThreadingModel="both"
						Description="Virtual Camera COM object"
						Server="VCamComDll"
						   />
				</Component>
			</Directory>
		</StandardDirectory>

		<!-- App C# + dipendenze gestite + risorse localizzate.
		     Raccolte dalla cartella di output del progetto (bin condivisa dai 3 progetti),
		     escludendo gli artefatti di build, i log e la VirtualCamera.dll (gia' esplicita). -->
		<ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
			<Files Include="$(var.RTVirtualCamera.TargetDir)**">
				<Exclude Files="$(var.RTVirtualCamera.TargetDir)**\*.pdb" />
				<Exclude Files="$(var.RTVirtualCamera.TargetDir)**\*.lib" />
				<Exclude Files="$(var.RTVirtualCamera.TargetDir)**\*.exp" />
				<Exclude Files="$(var.RTVirtualCamera.TargetDir)**\*.metagen" />
				<Exclude Files="$(var.RTVirtualCamera.TargetDir)**\*.xml" />
				<Exclude Files="$(var.RTVirtualCamera.TargetDir)**\*.log" />
				<Exclude Files="$(var.RTVirtualCamera.TargetDir)**\settings.json" />
				<Exclude Files="$(var.RTVirtualCamera.TargetDir)VirtualCamera.dll" />
			</Files>
		</ComponentGroup>

		<!-- Start Menu shortcut: the primary, non-optional way to launch the app. -->
		<StandardDirectory Id="ProgramMenuFolder">
			<Component Id="StartMenuShortcut" Guid="*">
				<Shortcut Id="AppStartMenuShortcut"
						  Name="RTVirtualCamera"
						  Description="RTSP Virtual Camera"
						  Target="[INSTALLFOLDER]RTVirtualCamera.exe"
						  WorkingDirectory="INSTALLFOLDER" />
				<RemoveFolder Id="RemoveStartMenuShortcut" On="uninstall" />
				<RegistryValue Root="HKCU"
							   Key="Software\RTVirtualCamera"
							   Name="StartMenuShortcut"
							   Type="integer"
							   Value="1"
							   KeyPath="yes" />
			</Component>
		</StandardD