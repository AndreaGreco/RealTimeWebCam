<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
	 xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

	<!-- BuildVersion is generated from git into Version.g.wxi (build/Set-GitVersion.ps1). -->
	<?include Version.g.wxi ?>

	<Package Name="RTVirtualCamera"
			 Manufacturer="RTVirtualCamera"
			 Version="$(BuildVersion)"
			 InstallerVersion="500"
			 UpgradeCode="e562ae5c-6739-11f1-a64b-80fa5b84a72b"
			 Compressed="yes"
			 >

		<!-- Embed the cab inside the MSI so the installer is a single file -->
		<MediaTemplate EmbedCab="yes" CompressionLevel="high" />

		<!-- Clean upgrade behavior: without this, UpgradeCode alone does nothing and
		     installing a newer MSI over an older one just errors out instead of
		     replacing it. DowngradeError is declared in Package.en-us.wxl.
		     AllowSameVersionUpgrades: the MSI ProductVersion is only major.minor.patch
		     (build/Set-GitVersion.ps1), so every commit after a tag builds the same
		     version; without this, two such builds would install side by side instead
		     of replacing each other (ICE61 warning, expected). -->
		<MajorUpgrade DowngradeErrorMessage="!(loc.DowngradeError)"
					  AllowSameVersionUpgrades="yes" />

		<!-- Windows 11 (build 22000+) only: MFCreateVirtualCamera doesn't exist
		     earlier. Read the real build number from the registry: Windows
		     Installer's own VersionNT/WindowsBuild are frozen at the Windows 8.1
		     values (603/9600) on Windows 10 and 11. -->
		<Property Id="WINDOWSBUILDNUMBER">
			<RegistrySearch Id="WindowsBuildNumberSearch"
							Root="HKLM"
							Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion"
							Name="CurrentBuildNumber"
							Type="raw" />
		</Property>
		<Launch Condition="Installed OR (WINDOWSBUILDNUMBER &gt;= 22000)"
				Message="!(loc.RequiresWindows11)" />

		<!-- Settings > Apps / Programs and Features links. -->
		<Property Id="ARPCOMMENTS" Value="!(loc.ArpComments)" />
		<Property Id="ARPURLINFOABOUT" Value="https://github.com/AndreaGreco/RealTimeWebCam" />
		<Property Id="ARPHELPLINK" Value="https://github.com/AndreaGreco/RealTimeWebCam/issues" />
		<Property Id="ARPURLUPDATEINFO" Value="https://github.com/AndreaGreco/RealTimeWebCam/releases/latest" />

		<!-- Icon shown in Settings > Apps / Programs and Features. Shortcuts below
		     don't need this: a Shortcut whose Target is the .exe directly picks up
		     the icon embedded in RTVirtualCamera.exe (see ApplicationIcon in the
		     csproj) automatically. -->
		<Icon Id="AppIcon.ico" SourceFile="..\RTVirtualCamera\Resources\Icon.ico" />
		<Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />

		<StandardDirectory Id="ProgramFiles64Folder">
			<Directory Id="INSTALLFOLDER" Name="RTVirtualCamera">
				<!-- COM DLL: esplicita perche' serve la registrazione <Class>.
				     Tutto il resto dell'app viene raccolto da <Files> qui sotto. -->
				<Component Id="CameraCOM">
					<File Id="VCamComDll" Source="$(var.VCamSampleSource.TargetPath)" />
					<Class Id="3CAD447D-F283-4AF4-A3B2-6F5363309F52"
						Context="InprocServer32"
						ThreadingModel="both"
						Description="Virtual Camera COM object"
						Server="VCamComDll"
						   />
					<!-- The Frame Server (svchost, Local Service) keeps this DLL loaded
					     while a camera is open, and holds the frame/stats mappings in the
					     old layout. Stop it on install and uninstall so the file isn't
					     locked (no reboot prompt) and a wire-format change never meets a
					     still-live old section. No Start: both services are
					     trigger-started by Windows the next time a camera is opened. -->
					<ServiceControl Id="StopFrameServer" Name="FrameServer" Stop="both" Wait="yes" />
					<ServiceControl Id="StopFrameServerMonitor" Name="FrameServerMonitor" Stop="both" Wait="yes" />
				</Component>
				<!-- LGPL notice for the FFmpeg libraries bundled by the FFmpeg engine.
				     The FFmpeg DLLs themselves are copied into the build output by vcpkg
				     (applocal) and picked up by the AppFiles glob below. -->
				<Component Id="ThirdPartyNotices">
					<File Id="ThirdPartyNoticesFile" Source="..\THIRD_PARTY_NOTICES.md" />
				</Component>
			</Directory>
		</StandardDirectory>

		<!-- App C# + dipendenze gestite + risorse localizzate.
		     Raccolte dalla cartella di output del progetto (bin condivisa dai 3 progetti),
		     escludendo gli artefatti di build, i log e la VirtualCamera.dll (gia' esplicita). -->
		<ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
			<Files Include="$(var.RTVirtualCamera.TargetDir)**">
				<Exclude Files="$(var.RTVirtualCamera.TargetDir)**\*.pdb" />
				<Exclude Files="$(var.RTVirtualCamera.TargetDir)**\*.lib" />
				<Exclude Files="$(var.RTVirtualCamera.TargetDir)**\*.exp" />
				<Exclude Files="$(var.RTVirtualCamera.TargetDir)**\*.metagen" />
				<Exclude Files="$(var.RTVirtualCamera.TargetDir)**\*.xml" />
				<Exclude Files="$(var.RTVirtualCamera.TargetDir)**\*.log" />
				<Exclude Files="$(var.RTVirtualCamera.TargetDir)**\settings.json" />
				<Exclude Files="$(var.RTVirtualCamera.TargetDir)VirtualCamera.dll" />
				<!-- .NET runtime diagnostics only (crash-dump helper, PDB reader for
				     line numbers in stack traces; no PDBs are shipped anyway). -->
				<Exclude Files="$(var.RTVirtualCamera.TargetDir)createdump.exe" />
				<Exclude Files="$(var.RTVirtualCamera.TargetDir)Microsoft.DiaSymReader.Native.amd64.dll" />
			</Files>
		</ComponentGroup>

		<!-- Start Menu shortcut: the primary, non-optional way to launch the app.
		     The KeyPath must stay under HKCU even though the package is per-machine:
		     ICE38/ICE43/ICE57 treat shortcut folders as user profile and fail the
		     build with an HKLM KeyPath. -->
		<StandardDirectory Id="ProgramMenuFolder">
			<Component Id="StartMenuShortcut" Guid="*">
				<Shortcut Id="AppStartMenuShortcut"
						  Name="RTVirtualCamera"
						  Description="RTSP Virtual Camera"
						  Target="[INSTALLFOLDER]RTVirtualCamera.exe"
						  WorkingDirectory="INSTALLFOLDER" />
				<RemoveFolder Id="RemoveStartMenuShortcut" On="uninstall" />
				<RegistryValue Root="HKCU"
							   Key="Software\RTVirtualCamera"
							   Name="StartMenuShortcut"
							   Type="integer"
							   Value="1"
							   KeyPath="yes" />
			</Component>
		</StandardDirectory>

		<!-- Optional desktop shortcut (own component so it can be a selectable feature) -->
		<StandardDirectory Id="DesktopFolder">
			<Component Id="DesktopShortcut" Guid="*">
				<Shortcut Id="AppDesktopShortcut"
						  Name="RTVirtualCamera"
						  Description="RTSP Virtual Camera"
						  Target="[INSTALLFOLDER]RTVirtualCamera.exe"
						  WorkingDirectory="INSTALLFOLDER" />
				<RegistryValue Root="HKCU"
							   Key="Software\RTVirtualCamera"
							   Name="DesktopShortcut"
							   Type="integer"
							   Value="1"
							   KeyPath="yes" />
			</Component>
		</StandardDirectory>

		<!-- MIT license shown + accepted before install -->
		<WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
		<ui:WixUI Id="WixUI_FeatureTree" />

		<!-- "Launch RTVirtualCamera" checkbox on the exit dialog (checked by default;
		     ExitDialog hides it on repair/uninstall). WixShellExec runs in the
		     non-elevated UI process, so the app starts as the user, not as admin. -->
		<Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="!(loc.LaunchApp)" />
		<Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
		<!-- The exe's File Id is generated by the <Files> harvest, so [#id] isn't
		     available; resolve the path once INSTALLFOLDER is final. -->
		<SetProperty Id="WixShellExecTarget"
					 Value="[INSTALLFOLDER]RTVirtualCamera.exe"
					 After="CostFinalize"
					 Sequence="ui" />
		<CustomAction Id="LaunchApplication"
					  BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
					  DllEntry="WixShellExec"
					  Impersonate="yes" />
		<UI>
			<Publish Dialog="ExitDialog"
					 Control="Finish"
					 Event="DoAction"
					 Value="LaunchApplication"
					 Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
		</UI>

		<!-- Main app: required. Desktop shortcut: optional, user-selectable. -->
		<Feature Id="MainApplication"
				 Title="RTVirtualCamera"
				 Description="Applicazione, pipeline e camera virtuale COM."
				 Level="1"
				 AllowAbsent="no"
				 Display="expand">
			<ComponentGroupRef Id="AppFiles" />
			<ComponentRef Id="CameraCOM" />
			<ComponentRef Id="ThirdPartyNotices" />
			<ComponentRef Id="StartMenuShortcut" />

			<Feature Id="DesktopShortcut"
					 Title="Collegamento sul desktop"
					 Description="Crea un'icona sul desktop per avviare RTVirtualCamera."
					 Level="1">
				<ComponentRef Id="DesktopShortcut" />
			</Feature>
		</Feature>
	</Package>
</Wix>
