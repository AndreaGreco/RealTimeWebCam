<WixLocalization xmlns="http://wixtoolset.org/schemas/v4/wxl" Culture="en-US">

  <String Id="DowngradeError" Value="A newer version of RTVirtualCamera is already installed." />
  <String Id="RequiresWindows11" Value="RTVirtualCamera requires Windows 11 (build 22000) or later: the virtual camera API it uses is not available on this version of Windows." />
  <String Id="LaunchApp" Value="Launch RTVirtualCamera" />
  <String Id="ArpComments" Value="Exposes an RTSP network camera as a Windows webcam." />

</WixLocalization>
